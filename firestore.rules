rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Profils utilisateurs : lisibles par tout utilisateur connecté (profil
    // public façon Facebook), mais seul le propriétaire peut modifier le sien.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;

      match /friends/{friendUid} {
        allow read: if isOwner(uid) || isOwner(friendUid);
        allow write: if isOwner(uid) || isOwner(friendUid);
      }

      match /friendRequests/{fromUid} {
        allow read: if isOwner(uid) || isOwner(fromUid);
        allow create: if isOwner(fromUid);
        allow delete: if isOwner(uid) || isOwner(fromUid);
      }
    }

    // Table de réservation des usernames : lecture publique nécessaire (la
    // vérification de disponibilité et la recherche ont lieu avant/pendant
    // l'inscription, donc parfois sans utilisateur encore connecté).
    // Aucune donnée sensible n'y est stockée (uniquement uid + username).
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Conversations 1:1 : lisibles/écrivables uniquement par les deux participants.
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderUid == request.auth.uid;
        allow update: if isSignedIn() && resource.data.senderUid == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
      }
    }

    // Statuts (stories) : visibles par l'auteur et ses amis uniquement.
    // La mise à jour est limitée au champ "viewedBy" (marquer comme vu),
    // pour empêcher qui que ce soit de modifier le contenu d'un statut existant.
    match /statuses/{statusId} {
      allow read: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        exists(/databases/$(database)/documents/users/$(resource.data.authorUid)/friends/$(request.auth.uid))
      );
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewedBy"]);
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    // Marketplace : anciennes annonces visibles par tout utilisateur connecté,
    // modifiables/supprimables uniquement par leur auteur.
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.sellerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.sellerUid == request.auth.uid;
    }

    // Marketplace : boutiques.
    match /shops/{shopId} {
      // Les boutiques sont publiques à l'intérieur de l'application pour les utilisateurs connectés.
      allow read: if isSignedIn();
      // Une boutique est créée/modifiée uniquement par son propriétaire.
      // Le document de la boutique est normalement identifié par l'UID du propriétaire.
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && shopId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && shopId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Marketplace : produits.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && exists(/databases/$(database)/documents/shops/$(request.resource.data.shopId))
        && get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.sellerUid == request.auth.uid
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.shopId == resource.data.shopId;
      allow delete: if isSignedIn() && resource.data.sellerUid == request.auth.uid;
    }

    // Marketplace : commandes.
    match /orders/{orderId} {
      // L'acheteur peut consulter ses commandes ; le propriétaire de la boutique
      // peut consulter les commandes reçues par sa boutique.
      allow read: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/shops/$(resource.data.shopId)) &&
          get(/databases/$(database)/documents/shops/$(resource.data.shopId)).data.ownerUid == request.auth.uid
        )
      );

      // Seul un utilisateur connecté peut créer une commande en son nom.
      allow create: if isSignedIn()
        && request.resource.data.buyerUid == request.auth.uid
        && exists(/databases/$(database)/documents/shops/$(request.resource.data.shopId));

      // Le vendeur peut changer le statut ; l'acheteur ne peut pas modifier
      // la commande après création.
      allow update: if isSignedIn()
        && exists(/databases/$(database)/documents/shops/$(resource.data.shopId))
        && get(/databases/$(database)/documents/shops/$(resource.data.shopId)).data.ownerUid == request.auth.uid
        && request.resource.data.buyerUid == resource.data.buyerUid
        && request.resource.data.shopId == resource.data.shopId;

      allow delete: if false;
    }

    // Appels audio/vidéo : lisibles/écrivables uniquement par l'appelant et l'appelé.
    match /calls/{callId} {
      allow read: if isSignedIn() && (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.callerUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid);

      match /callerCandidates/{id} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid
        );
        allow create: if isSignedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid;
      }
      match /calleeCandidates/{id} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid
        );
        allow create: if isSignedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid;
      }
    }

    // Groupes : lisibles/écrivables uniquement par leurs membres.
    // - Un admin (adminUids, ou le propriétaire si le groupe est ancien et
    //   n'a pas encore ce champ) peut tout modifier : nom, photo,
    //   description, adminUids, et retirer des membres.
    // - Un membre simple peut uniquement AJOUTER des membres (memberUids ne
    //   peut que grandir, jamais rétrécir) et laisser passer les mises à
    //   jour de lastMessage/lastMessageAt faites par l'envoi de message.
    match /groups/{groupId} {
      function isGroupAdmin() {
        return ('adminUids' in resource.data)
          ? request.auth.uid in resource.data.adminUids
          : request.auth.uid == resource.data.ownerUid;
      }

      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberUids;
      allow update: if isSignedIn() && request.auth.uid in resource.data.memberUids && (
        isGroupAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUids", "lastMessage", "lastMessageAt"]) &&
          request.resource.data.memberUids.hasAll(resource.data.memberUids)
        )
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerUid;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
