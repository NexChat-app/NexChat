rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function conversation(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function isParticipant(conversationId) {
      return signedIn()
        && request.auth.uid in conversation(conversationId).data.participants;
    }

    function isGroup(conversationId) {
      return conversation(conversationId).data.type == 'group';
    }

    function isAdmin(conversationId) {
      return signedIn()
        && request.auth.uid in conversation(conversationId).data.admins;
    }

    function isCreator(conversationId) {
      return signedIn()
        && conversation(conversationId).data.createdBy == request.auth.uid;
    }

    function participantListUnchanged() {
      return request.resource.data.participants == resource.data.participants;
    }

    function creatorUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy;
    }

    function adminListUnchanged() {
      return request.resource.data.admins == resource.data.admins;
    }

    function groupMetadataUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'photoURL', 'updatedAt']);
    }

    function messageMetadataUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'lastMessage',
          'lastMessageSenderId',
          'lastMessageAt',
          'updatedAt'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['lastMessage', 'lastMessageSenderId', 'lastMessageAt'])
          || request.resource.data.lastMessageSenderId == request.auth.uid
        );
    }

    function addOneParticipant() {
      return request.resource.data.participants.size()
          == resource.data.participants.size() + 1
        && request.resource.data.participants.hasAll(resource.data.participants);
    }

    function removeOneParticipant() {
      return request.resource.data.participants.size()
          == resource.data.participants.size() - 1
        && resource.data.participants.hasAll(request.resource.data.participants);
    }

    function validAdminList() {
      return request.resource.data.admins.hasAll([request.resource.data.createdBy])
        && request.resource.data.participants.hasAll(request.resource.data.admins);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /conversations/{conversationId} {
      allow read: if isParticipant(conversationId);

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && (
          request.resource.data.type == 'direct'
          || (
            request.resource.data.type == 'group'
            && request.resource.data.createdBy == request.auth.uid
            && request.auth.uid in request.resource.data.admins
            && request.resource.data.participants.hasAll(request.resource.data.admins)
          )
        );

      allow update: if isParticipant(conversationId)
        && (
          // Direct conversations: members cannot alter membership, admins, or ownership.
          (
            !isGroup(conversationId)
            && participantListUnchanged()
            && adminListUnchanged()
            && creatorUnchanged()
            && (
              groupMetadataUpdate()
              || messageMetadataUpdate()
            )
          )

          ||

          // Any group member may update only group presentation metadata.
          (
            isGroup(conversationId)
            && (isCreator(conversationId) || isAdmin(conversationId))
            && participantListUnchanged()
            && adminListUnchanged()
            && creatorUnchanged()
            && groupMetadataUpdate()
          )

          ||

          // Any group member may publish conversation preview metadata.
          (
            isGroup(conversationId)
            && participantListUnchanged()
            && adminListUnchanged()
            && creatorUnchanged()
            && messageMetadataUpdate()
          )

          ||

          // Creator may add exactly one member.
          (
            isGroup(conversationId)
            && isCreator(conversationId)
            && creatorUnchanged()
            && adminListUnchanged()
            && addOneParticipant()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participants', 'participantProfiles', 'updatedAt'])
          )

          ||

          // Creator may remove exactly one non-creator member.
          (
            isGroup(conversationId)
            && isCreator(conversationId)
            && creatorUnchanged()
            && removeOneParticipant()
            && resource.data.createdBy in request.resource.data.participants
            && validAdminList()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participants', 'participantProfiles', 'admins', 'updatedAt'])
          )

          ||

          // Admins may add exactly one member.
          (
            isGroup(conversationId)
            && isAdmin(conversationId)
            && creatorUnchanged()
            && adminListUnchanged()
            && addOneParticipant()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participants', 'participantProfiles', 'updatedAt'])
          )

          ||

          // Admins may remove exactly one non-admin member.
          (
            isGroup(conversationId)
            && isAdmin(conversationId)
            && !isCreator(conversationId)
            && creatorUnchanged()
            && adminListUnchanged()
            && removeOneParticipant()
            && request.auth.uid in request.resource.data.participants
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participants', 'participantProfiles', 'updatedAt'])
          )

          ||

          // A member may leave by removing only their own membership.
          (
            isGroup(conversationId)
            && removeOneParticipant()
            && request.auth.uid != resource.data.createdBy
            && !(request.auth.uid in request.resource.data.participants)
            && (
              (
                request.auth.uid in resource.data.admins
                && request.resource.data.admins.size() == resource.data.admins.size() - 1
                && resource.data.admins.hasAll(request.resource.data.admins)
                && !(request.auth.uid in request.resource.data.admins)
              )
              ||
              (
                !(request.auth.uid in resource.data.admins)
                && adminListUnchanged()
              )
            )
            && creatorUnchanged()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participants', 'participantProfiles', 'admins', 'updatedAt'])
          )

          ||

          // Only the creator may grant or revoke administrator status.
          (
            isGroup(conversationId)
            && isCreator(conversationId)
            && participantListUnchanged()
            && creatorUnchanged()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['admins', 'updatedAt'])
            && validAdminList()
          )

          ||

          // Only the creator may transfer ownership.
          (
            isGroup(conversationId)
            && isCreator(conversationId)
            && participantListUnchanged()
            && request.resource.data.createdBy in resource.data.participants
            && request.resource.data.createdBy in request.resource.data.admins
            && resource.data.createdBy in request.resource.data.admins
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['createdBy', 'admins', 'updatedAt'])
            && validAdminList()
          )
        );

      // A group cannot be deleted by an ordinary participant.
      // The creator remains the only account allowed to delete the conversation.
      allow delete: if isCreator(conversationId);

      match /messages/{messageId} {
        allow read: if isParticipant(conversationId);

        allow create: if isParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid;

        // Participants may update only their own reaction entry.
        allow update: if isParticipant(conversationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys()
            .hasOnly([request.auth.uid]);

        // Recipients may mark delivery once. The sender cannot mark their own message delivered.
        allow update: if isParticipant(conversationId)
          && resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredAt'])
          && resource.data.get('deliveredAt', null) == null;

        // Recipients may add only their own read marker.
        allow update: if isParticipant(conversationId)
          && resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.get('readBy', {}).diff(resource.data.get('readBy', {})).affectedKeys()
            .hasOnly([request.auth.uid]);

        // A sender may edit text and record the edit timestamp.
        allow update: if isParticipant(conversationId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'editedAt']);

        // A sender may soft-delete a message.
        allow update: if isParticipant(conversationId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'deletedAt']);

        allow delete: if isParticipant(conversationId)
          && resource.data.senderId == request.auth.uid;
      }
    }
    match /calls/{callId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.status == 'ringing'
        && (request.resource.data.kind == 'audio' || request.resource.data.kind == 'video');
      allow update: if signedIn()
        && request.auth.uid == resource.data.callerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer','updatedAt'])
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.participants == resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.auth.uid != resource.data.callerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','status','updatedAt'])
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.status == 'accepted';
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.participants == resource.data.participants
        && (
          request.resource.data.status == 'ended'
          || (request.resource.data.status == 'declined' && request.auth.uid != resource.data.callerId)
        );
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
      match /iceCandidates/{candidateId} {
        allow read, create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
      }
    }
  }
}
